{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"],
  "exclude": [
    "test/_*.test.ts",
    "test/zz*.test.ts",
    "test/zhunt*.test.ts",
    "test/verify*.test.ts",
    "test/probe*.test.ts"
  ]
}
